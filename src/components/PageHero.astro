---
const { eyebrow, title, text } = Astro.props;
---
<section class="relative overflow-hidden bg-navy text-white">
  <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-electric/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-mint/10 blur-3xl"></div>
  <svg class="absolute inset-0 h-full w-full opacity-[0.06]" aria-hidden="true"><defs><pattern id="ph" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#fff" stroke-width="0.8"/></pattern></defs><rect width="100%" height="100%" fill="url(#ph)"/></svg>
  <div class="container-x relative py-16 sm:py-24">
    <nav class="mb-4 text-sm text-white/50" aria-label="Ruta"><a href="/" class="link-anim">Inicio</a> <span class="mx-1">/</span> <span class="text-mint">{eyebrow ?? title}</span></nav>
    <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
    <span class="mt-5 block h-1 w-20 rounded-full bg-gradient-to-r from-mint to-electric"></span>
    {text && <p class="mt-5 max-w-2xl text-lg text-white/70">{text}</p>}
  </div>
</section>
