---
import Icon from './Icon.astro';
import Visual from './Visual.astro';
const { service } = Astro.props;
---
<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <div class="relative h-44 overflow-hidden">
    <div class="zoom h-full w-full"><Visual src={service.image} icon={service.icon} alt={service.title} label="Ilustración técnica" /></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy/70 to-transparent"></div>
    <span class="icon-box absolute -bottom-6 left-6 flex h-14 w-14 items-center justify-center rounded-xl bg-electric text-white shadow-lg ring-4 ring-white"><Icon name={service.icon} class="h-7 w-7" /></span>
  </div>
  <div class="flex flex-1 flex-col p-6 pt-10">
    <h3 class="text-lg font-bold leading-snug transition-colors group-hover:text-tech">{service.title}</h3>
    <p class="mt-3 text-sm text-graphite">{service.summary}</p>
    <p class="mt-5 text-xs font-bold uppercase tracking-wider text-navy">Aplicaciones típicas</p>
    <ul class="mt-2 space-y-1.5 text-sm text-graphite">
      {service.applications.map((a: string) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-mint" />{a}</li>)}
    </ul>
    <a href={`/contacto?servicio=${service.slug}`} class="mt-auto inline-flex items-center gap-2 self-start pt-6 text-sm font-bold text-electric transition-all group-hover:gap-3 group-hover:text-tech">
      Consultar servicio <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
</article>
