---
import Icon from './Icon.astro';
import { nav, site, whatsappUrl } from '../data/site';
import { services } from '../data/services';
const { lat, lon } = site.map;
const d = 0.05;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d},${lat - d},${lon + d},${lat + d}&layer=mapnik&marker=${lat},${lon}`;
const links = [...nav, { href: '/ubicacion', label: 'Ubicación' }];
---
<footer class="relative bg-navy text-white/75">
  <!-- Franja superior de contacto rápido -->
  <div class="container-x relative z-10 -top-10 -mb-4">
    <div class="grid overflow-hidden rounded-2xl bg-gradient-to-r from-tech to-electric shadow-2xl sm:grid-cols-3">
      <a href={whatsappUrl()} target="_blank" rel="noopener" class="group flex items-center gap-4 p-6 transition-colors hover:bg-white/10">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors group-hover:bg-mint group-hover:text-navy"><Icon name="phone" /></span>
        <span><span class="block text-xs uppercase tracking-wider text-white/70">WhatsApp</span><span class="font-bold text-white">{site.whatsappDisplay}</span></span>
      </a>
      <div class="group flex items-center gap-4 border-white/15 p-6 transition-colors hover:bg-white/10 sm:border-x">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors group-hover:bg-mint group-hover:text-navy"><Icon name="mail" /></span>
        <span><span class="block text-xs uppercase tracking-wider text-white/70">Correo</span><span class="font-bold text-white">{site.email ?? 'A confirmar'}</span></span>
      </div>
      <a href="/ubicacion" class="group flex items-center gap-4 p-6 transition-colors hover:bg-white/10">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15 transition-colors group-hover:bg-mint group-hover:text-navy"><Icon name="pin" /></span>
        <span><span class="block text-xs uppercase tracking-wider text-white/70">Ubicación</span><span class="font-bold text-white">San Martín, Mendoza</span></span>
      </a>
    </div>
  </div>

  <div class="container-x grid gap-10 pb-12 pt-2 md:grid-cols-2 lg:grid-cols-12">
    <!-- Marca -->
    <div class="lg:col-span-4">
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="" class="h-12 w-12" />
        <div>
          <p class="text-xl font-extrabold text-white">G.A.D. Control</p>
          <p class="text-[11px] uppercase tracking-[0.14em] text-mint">Instrumentación y Control Industrial</p>
        </div>
      </div>
      <p class="mt-5 text-sm leading-relaxed">Soluciones técnicas para la medición, automatización y control de procesos industriales, adaptadas a cada instalación.</p>
      <a href="/contacto" class="btn-primary mt-6">Solicitar presupuesto <Icon name="arrow" class="h-4 w-4" /></a>
    </div>

    <!-- Navegación -->
    <div class="lg:col-span-2">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Navegación</h3>
      <span class="mt-2 block h-0.5 w-8 bg-mint"></span>
      <ul class="mt-4 space-y-2.5 text-sm">
        {links.map((n) => <li><a class="link-anim" href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>

    <!-- Servicios -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Servicios</h3>
      <span class="mt-2 block h-0.5 w-8 bg-mint"></span>
      <ul class="mt-4 space-y-2.5 text-sm">
        {services.filter((s) => s.active).slice(0, 6).map((s) => <li><a class="link-anim" href={`/contacto?servicio=${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </div>

    <!-- Mapa -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Dónde estamos</h3>
      <span class="mt-2 block h-0.5 w-8 bg-mint"></span>
      <div class="group mt-4 overflow-hidden rounded-xl border border-white/10 transition-all duration-300 hover:border-mint">
        <iframe title="Mapa de San Martín, Mendoza" src={mapSrc} class="h-44 w-full grayscale transition-all duration-500 group-hover:grayscale-0" loading="lazy"></iframe>
      </div>
      <p class="mt-3 flex items-center gap-2 text-sm"><Icon name="pin" class="h-4 w-4 text-mint" />{site.city}</p>
      <p class="mt-1 flex items-center gap-2 text-sm"><Icon name="clock" class="h-4 w-4 text-mint" />{site.hours ?? 'Horarios a confirmar'}</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-3 py-5 text-xs text-white/50 sm:flex-row">
      <p>© {new Date().getFullYear()} G.A.D. Control. Todos los derechos reservados.</p>
      <div class="flex gap-5">
        <a class="link-anim" href="/privacidad">Aviso de privacidad</a>
        <a class="link-anim" href="#main">Volver arriba ↑</a>
      </div>
    </div>
  </div>
</footer>
