---
// Componente de imagen visual con manejo inteligente de nitidez y formato
const { src, alt = '', icon = 'gauge', label = 'Demostración', class: cls = '' } = Astro.props;
import Icon from './Icon.astro';

// Renders y diagramas con fondo blanco se visualizan mejor con fondo limpio y sin recortar
const isRender = src && (src.includes('paletizadora') || src.includes('enfriador'));
---
{src ? (
  <div class={`relative flex h-full w-full items-center justify-center overflow-hidden ${isRender ? 'bg-white p-3' : 'bg-navy'} ${cls}`}>
    <img
      src={src}
      alt={alt}
      loading="lazy"
      class={`h-full w-full transition-all duration-500 ${isRender ? 'object-contain' : 'object-cover'}`}
      style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"
    />
  </div>
) : (
  <div class={`relative flex h-full w-full items-center justify-center overflow-hidden bg-navy ${cls}`} role="img" aria-label={alt || label}>
    <svg class="absolute inset-0 h-full w-full opacity-20" aria-hidden="true">
      <defs><pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="#168BFF" stroke-width="0.6"/></pattern></defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
    <Icon name={icon} class="relative h-14 w-14 text-electric" />
    <span class="absolute bottom-2 left-3 rounded bg-white/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/70">{label}</span>
  </div>
)}
