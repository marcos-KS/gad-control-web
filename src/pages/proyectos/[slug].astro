---
import Layout from '../../layouts/Layout.astro';
import Visual from '../../components/Visual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const related = projects.filter((p) => p.slug !== project.slug && p.category === project.category)
  .concat(projects.filter((p) => p.slug !== project.slug && p.category !== project.category)).slice(0, 2);
const gallery = project.gallery ?? [];
---
<Layout title={project.title} description={project.summary}>
  <section class="bg-navy text-white">
    <div class="container-x py-12 sm:py-16">
      <a href="/proyectos" class="text-sm text-white/70 hover:text-white">← Proyectos</a>
      <p class="eyebrow mt-4">{project.category}</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight">{project.title}</h1>
      {project.demo ? (
        <p class="mt-4 inline-block rounded bg-amber-400 px-3 py-1 text-sm font-bold text-navy">Ejemplo editable: no es un trabajo real de G.A.D. Control</p>
      ) : (
        <span class="mt-4 inline-flex items-center gap-2 rounded-full bg-mint/20 border border-mint/40 px-3.5 py-1 text-xs font-bold text-mint backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-mint animate-pulse"></span> Proyecto desarrollado por G.A.D. Control
        </span>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="space-y-10 lg:col-span-2">
        <div class="h-72 overflow-hidden rounded-xl sm:h-96"><Visual src={project.image} icon="panel" alt={project.title} label={project.demo ? 'Demostración' : 'Proyecto'} /></div>
        <div><h2 class="text-2xl font-extrabold">Necesidad</h2><p class="mt-3 text-graphite">{project.need}</p></div>
        <div><h2 class="text-2xl font-extrabold">Solución técnica</h2><p class="mt-3 text-graphite">{project.solution}</p></div>
        {gallery.length > 0 && (
          <div><h2 class="text-2xl font-extrabold">Galería</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">{gallery.map((g: string) => <div class="h-48 overflow-hidden rounded-xl"><Visual src={g} alt={project.title} /></div>)}</div>
          </div>
        )}
        <div><h2 class="text-2xl font-extrabold">Resultados</h2>
          {project.results.length > 0
            ? <ul class="mt-3 space-y-2 text-graphite">{project.results.map((r: string) => <li class="flex gap-2"><Icon name="check" class="h-5 w-5 text-electric" />{r}</li>)}</ul>
            : <p class="mt-3 text-graphite">Sin resultados documentados por el momento.</p>}
        </div>
      </div>
      <aside class="space-y-6">
        <div class="card p-6">
          <h2 class="font-bold">Equipos y tecnologías</h2>
          <ul class="mt-3 space-y-2 text-sm text-graphite">{project.equipment.map((e: string) => <li class="flex gap-2"><Icon name="check" class="h-4 w-4 mt-0.5 shrink-0 text-electric" />{e}</li>)}</ul>
        </div>
        <a href={`/contacto?proyecto=${project.slug}`} class="btn-primary w-full">Consultar por una solución similar</a>
      </aside>
    </div>
  </section>
  <section class="section bg-mist"><div class="container-x">
    <h2 class="text-2xl font-extrabold">Proyectos relacionados</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{related.map((p) => <ProjectCard project={p} />)}</div>
  </div></section>
  <CtaBand />
</Layout>
