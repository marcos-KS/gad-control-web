---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Brands from '../components/Brands.astro';
import { services } from '../data/services';
import { projects } from '../data/projects';

// Si existe /public/img/hero.jpg se usa como fotografía de fondo.
const heroPhoto = fs.existsSync('public/img/hero.jpg') ? '/img/hero.jpg' : null;
const featured = services.filter((s) => s.active).slice(0, 6);
const steps = [
  ['search', 'Relevamiento', 'Visita y análisis de la instalación y de la necesidad.'],
  ['tools', 'Propuesta técnica', 'Definición de alcance, equipos y plan de trabajo.'],
  ['cpu', 'Implementación', 'Instalación, cableado, programación y puesta en marcha.'],
  ['shield', 'Verificación y soporte', 'Pruebas, documentación y acompañamiento posterior.'],
];
const pillars = [
  ['shield', 'Seguridad y calidad', 'Trabajo ordenado y responsable en cada intervención.'],
  ['tools', 'Soluciones a medida', 'Cada instalación se analiza según su proceso.'],
  ['wave', 'Medición confiable', 'Señales verificadas y documentadas.'],
  ['link', 'Integración', 'Equipos y sistemas que funcionan en conjunto.'],
];
---
<Layout>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy text-white">
    {heroPhoto && (
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <img
          src={heroPhoto}
          alt=""
          class="h-full w-full object-cover opacity-20 filter blur-[1px] scale-105"
          style="image-rendering: auto;"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/70"></div>
      </div>
    )}
    <div class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-electric/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-20 h-96 w-96 rounded-full bg-mint/15 blur-3xl"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true"><defs><pattern id="hg" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#fff" stroke-width="0.8"/></pattern></defs><rect width="100%" height="100%" fill="url(#hg)"/></svg>

    <div class="container-x relative grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <span class="badge"><span class="h-2 w-2 animate-pulse rounded-full bg-mint"></span> San Martín, Mendoza · Argentina</span>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
          Instrumentación y control para una industria <span class="bg-gradient-to-r from-mint to-electric bg-clip-text text-transparent">más eficiente</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/75">Desarrollamos soluciones técnicas para la medición, automatización y control de procesos industriales, adaptadas a las necesidades de cada instalación.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/servicios" class="btn-primary">Conocer nuestros servicios <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/proyectos" class="btn-outline">Ver proyectos</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
          {['Instrumentación', 'Automatización', 'Control de procesos'].map((t) => <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-mint" />{t}</li>)}
        </ul>
      </div>

      <!-- Panel técnico decorativo -->
      <div class="hidden lg:col-span-5 lg:block" aria-hidden="true">
        <div class="relative rounded-2xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl backdrop-blur">
          <div class="mb-5 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-widest text-white/50">Variables de proceso</span>
            <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-mint"></span><span class="h-2.5 w-2.5 rounded-full bg-electric"></span><span class="h-2.5 w-2.5 rounded-full bg-white/30"></span></span>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[['gauge','Presión'],['thermo','Temperatura'],['flow','Caudal'],['sensor','Nivel']].map(([i,l]) => (
              <div class="group rounded-xl bg-navy/70 p-5 ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1 hover:ring-mint">
                <Icon name={i} class="h-8 w-8 text-electric transition-colors group-hover:text-mint" />
                <p class="mt-3 text-sm font-semibold">{l}</p>
                <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-electric to-mint"></div></div>
              </div>
            ))}
          </div>
          <div class="mt-4 flex items-center justify-between rounded-xl bg-navy/70 p-4 text-sm ring-1 ring-white/10">
            <span class="flex items-center gap-2"><Icon name="wave" class="h-5 w-5 text-mint" /> Señal 4–20 mA</span>
            <span class="font-mono text-xs text-white/50">PLC · HMI</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILARES (tarjetas superpuestas al hero) -->
  <section class="relative z-10 -mt-12">
    <div class="container-x grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map(([i, t, d]) => (
        <div class="card card-hover reveal group p-6">
          <span class="icon-box flex h-12 w-12 items-center justify-center rounded-xl bg-mint-soft text-tech"><Icon name={i} /></span>
          <h3 class="mt-4 font-bold">{t}</h3>
          <p class="mt-1 text-sm text-graphite">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="container-x">
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Servicios principales</p>
          <h2 class="h2">Qué podemos hacer por su instalación</h2>
          <p class="mt-4 max-w-2xl text-graphite">Propuesta inicial de servicios, sujeta a confirmación.</p>
        </div>
        <a href="/servicios" class="btn-outline-dark shrink-0">Ver todos <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{featured.map((s) => <div class="reveal"><ServiceCard service={s} /></div>)}</div>
    </div>
  </section>

  <!-- PRESENTACIÓN -->
  <section class="section relative overflow-hidden bg-mist">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div class="reveal relative">
        <div class="absolute -left-4 -top-4 h-full w-full rounded-2xl border-2 border-mint"></div>
        <div class="relative overflow-hidden rounded-2xl border border-navy/10 bg-navy shadow-2xl">
          <img src="/img/servicios/componentes-tablero.png" alt="Montaje de tableros industriales y protecciones Siemens" class="h-80 w-full object-cover opacity-85 transition-transform duration-500 hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <div class="flex items-center gap-3">
              <img src="/logo.svg" alt="" class="h-10 w-10" />
              <div>
                <p class="text-xl font-extrabold leading-none">G.A.D. Control</p>
                <p class="text-[10px] uppercase tracking-[0.16em] text-mint">San Martín, Mendoza</p>
              </div>
            </div>
            <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs font-semibold text-white/90">
              <span class="rounded bg-white/10 py-1.5 backdrop-blur">Tableros</span>
              <span class="rounded bg-white/10 py-1.5 backdrop-blur">Automatización</span>
              <span class="rounded bg-white/10 py-1.5 backdrop-blur">Diagnóstico</span>
            </div>
          </div>
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow">Sobre nosotros</p>
        <h2 class="h2">Soluciones técnicas desde San Martín, Mendoza</h2>
        <p class="mt-5 text-graphite">G.A.D. Control es una empresa dedicada a la instrumentación y el control industrial. Trabajamos cada proyecto con criterio técnico, orden y comunicación clara.</p>
        <ul class="mt-6 space-y-3">
          {['Atención directa y personalizada', 'Soluciones adaptadas a cada proceso', 'Documentación clara de cada trabajo'].map((t) => (
            <li class="flex items-center gap-3"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-mint text-navy"><Icon name="check" class="h-4 w-4" /></span>{t}</li>
          ))}
        </ul>
        <a href="/nosotros" class="btn-primary mt-8">Conocer más <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- PROYECTOS -->
  <section class="section">
    <div class="container-x">
      <div class="reveal text-center">
        <p class="eyebrow">Proyectos destacados</p>
        <h2 class="h2 mx-auto">Trabajos y ejemplos</h2>
        <p class="mx-auto mt-4 max-w-2xl text-graphite">Los proyectos marcados como “Ejemplo editable” son demostraciones, no trabajos reales.</p>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{projects.slice(0, 3).map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}</div>
      <div class="mt-12 text-center"><a href="/proyectos" class="btn-outline-dark">Ver todos los proyectos <Icon name="arrow" class="h-4 w-4" /></a></div>
    </div>
  </section>

  <Brands />

  <!-- METODOLOGÍA -->
  <section class="section bg-mist">
    <div class="container-x">
      <div class="reveal text-center">
        <p class="eyebrow">Metodología de trabajo</p>
        <h2 class="h2 mx-auto">Cómo trabajamos</h2>
      </div>
      <ol class="relative mt-14 grid gap-8 md:grid-cols-4">
        <div class="absolute left-0 right-0 top-8 hidden h-0.5 bg-gradient-to-r from-electric via-mint to-electric md:block" aria-hidden="true"></div>
        {steps.map(([i, t, d], n) => (
          <li class="reveal group relative text-center">
            <span class="relative mx-auto flex h-16 w-16 items-center justify-center rounded-full border-4 border-mist bg-navy text-white shadow-lg transition-all duration-300 group-hover:scale-110 group-hover:bg-mint group-hover:text-navy">
              <Icon name={i} class="h-7 w-7" />
              <span class="absolute -right-1 -top-1 flex h-6 w-6 items-center justify-center rounded-full bg-electric text-[11px] font-bold text-white">{n + 1}</span>
            </span>
            <h3 class="mt-5 font-bold">{t}</h3>
            <p class="mt-2 text-sm text-graphite">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Layout>
